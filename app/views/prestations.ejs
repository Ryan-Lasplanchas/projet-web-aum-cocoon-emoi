<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Clara Bien-être</title>
</head>
<body>
    <h1>Prestations</h1>
    <p>Massages bien-être à Toulon.</p>
<% prestations.forEach((prestation) => { %>

    <h2><%= prestation.nom %></h2>
    <p><%= prestation.duree %></p>
    <p><%= prestation.prix %></p>

<% }); %>
</body>
</html>