<%- include("partials/header") %>

<main>

    <section class="page-introduction">

        <h1>Nos prestations</h1>

        <p>
            Découvrez les différentes prestations proposées
            par Aum Cocoon Emoi.
        </p>

        <p>
            Chaque prestation est pensée comme une invitation
            à prendre un moment pour soi.
        </p>

    </section>


    <section class="prestations-list">

        <% prestations.forEach(prestation => { %>

            <article class="prestation-card">

                <h2>
                    <%= prestation.categorie %>
                </h2>

                <p>
                    <%= prestation.description %>
                </p>


                <% if (prestation.activites) { %>

                    <div class="ateliers">

                        <h3>
                            Les ateliers proposés
                        </h3>

                        <ul>

                            <% prestation.activites.forEach(activite => { %>

                                <li>
                                    <%= activite %>
                                </li>

                            <% }); %>

                        </ul>

                    </div>

                <% } %>

            </article>

        <% }); %>

    </section>


    <section class="contact">

        <h2>
            Une question ?
        </h2>

        <p>
            Vous souhaitez obtenir davantage d'informations
            sur une prestation ou prendre rendez-vous ?
        </p>

        <a href="/contact" class="button">
            Contacter Cathy
        </a>

    </section>

</main>

<%- include("partials/footer") %>